PUBLIC_BASE_URL=http://localhost:8000
GATEWAY_DATABASE_URL=postgresql+psycopg://gateway:gateway@postgres:5432/gateway

GATEWAY_DEV_AUTH=true
GATEWAY_DEV_SUBJECT=dev:local
GATEWAY_DEV_USERNAME=local
GATEWAY_DEV_EMAIL=local@example.invalid
GATEWAY_JWT_SECRET=change-me-local-jwt-secret
GATEWAY_SECRET_KEY=

GATEWAY_SSH_ENABLED=true
GATEWAY_SSH_KNOWN_HOSTS_POLICY=accept-new
GATEWAY_SSH_KNOWN_HOSTS_PATH=/data/ssh/known_hosts
GATEWAY_SSH_COMMAND_PROFILE_DEFAULT=restricted
GATEWAY_SSH_ALLOWED_ACTIONS=uptime,disk_usage,memory_usage,whoami,pwd,home_list
GATEWAY_SSH_RAW_COMMAND_MAX_CHARS=8000

GATEWAY_DOCKER_ENABLED=false
GATEWAY_DOCKER_ALLOWED_IMAGES=ubuntu:24.04,ubuntu:22.04,ubuntu:20.04

GATEWAY_BROKER_BACKEND=nats
GATEWAY_NATS_SERVERS=nats://nats:4222
GATEWAY_NATS_STREAM=GATEWAY_EVENTS
GATEWAY_NATS_SUBJECT_PREFIX=gateway.events
GATEWAY_OUTBOX_ENABLED=true

GATEWAY_MCP_FEDERATION_ENABLED=true
GATEWAY_MCP_FEDERATION_WRITES_PAUSED=false
GATEWAY_MCP_UPSTREAM_ALLOW_PRIVATE_NETWORKS=false
GATEWAY_MCP_UPSTREAM_ALLOW_INSECURE_HTTP=false
GATEWAY_MCP_TRUSTED_INTERNAL_ENDPOINTS=

GATEWAY_CHAT_CONTEXT_ENABLED=false
GATEWAY_CHAT_CONTEXT_HMAC_KEY=
GATEWAY_CHAT_CONTEXT_HMAC_KEY_VERSION=1

GATEWAY_AUTONOMY_ENABLED=false
GATEWAY_AUTONOMY_EMERGENCY_STOP=false

GATEWAY_PROMPT_REGISTRY_ENABLED=false
GATEWAY_PROMPT_REGISTRY_BASE_URL=http://prompt-registry:8080
GATEWAY_PROMPT_REGISTRY_SERVICE_TOKEN=

KEYCLOAK_ISSUER=http://localhost:8080/realms/chatgpt-mcp
KEYCLOAK_CLIENT_ID=chatgpt-mcp-gateway
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CA_CERT_PATH=

MAX_COMMAND_TIMEOUT_SECONDS=120
COMMAND_BACKGROUND_AFTER_SECONDS=30
COMMAND_SESSION_SPOOL_ROOT=/data/command-sessions

NGROK_AUTHTOKEN=
