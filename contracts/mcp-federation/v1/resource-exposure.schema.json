{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gateway.invalid/contracts/mcp-federation/v1/resource-exposure.schema.json",
  "title": "Gateway MCP resource exposure",
  "description": "Operator-reviewed, exact-revision exposure policy for one federated MCP resource or resource template. This policy is independent from tool exposure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner_subject",
    "server_id",
    "entity_id",
    "revision_id",
    "entity_kind",
    "mode",
    "enabled",
    "approval_class",
    "projection_generation",
    "policy_generation",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "owner_subject": {"type": "string", "minLength": 1, "maxLength": 255},
    "server_id": {"type": "string", "format": "uuid"},
    "entity_id": {"type": "string", "format": "uuid"},
    "revision_id": {"type": "string", "format": "uuid"},
    "entity_kind": {"enum": ["resource", "resource_template"]},
    "mode": {"enum": ["hidden", "catalog_only", "native_projected"]},
    "enabled": {"type": "boolean"},
    "required_role": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "required_scope": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "approval_class": {"enum": ["none", "operator", "quorum", "production"]},
    "projection_generation": {"type": "integer", "minimum": 0},
    "policy_generation": {"type": "integer", "minimum": 1},
    "version": {"type": "integer", "minimum": 1},
    "reviewed_by_subject": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
