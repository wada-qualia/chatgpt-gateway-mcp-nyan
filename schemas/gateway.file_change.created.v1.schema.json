    "room_id",
    "agent_id",
    "lease_id",
    "fencing_token",
    "path",
    "operation",
    "before_sha256",
    "after_sha256",
    "added_lines",
    "removed_lines",
    "suppressed",
    "truncated"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
