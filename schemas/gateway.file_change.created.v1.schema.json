      ]
    },
    "room_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fencing_token": {
      "type": [
        "integer",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "before_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "after_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "added_lines": {
      "type": "integer"
    },
    "removed_lines": {
      "type": "integer"
