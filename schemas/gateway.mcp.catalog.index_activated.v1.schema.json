{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway.mcp.catalog.index_activated.v1",
  "title": "McpCatalogIndexActivated",
  "type": "object",
  "required": ["event_id", "occurred_at", "scope_server_id", "model_key", "model_version", "generation", "supersedes_generation_id", "transition"],
  "properties": {
    "event_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "scope_server_id": {"type": ["string", "null"]},
    "model_key": {"type": "string"},
    "model_version": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "supersedes_generation_id": {"type": ["string", "null"]},
    "transition": {"enum": ["activate", "rollback"]}
  },
  "additionalProperties": false
}
