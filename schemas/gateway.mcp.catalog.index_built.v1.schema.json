{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway.mcp.catalog.index_built.v1",
  "title": "McpCatalogIndexBuilt",
  "type": "object",
  "required": ["event_id", "occurred_at", "scope_server_id", "model_key", "model_version", "generation", "document_count", "source_catalog_sha256"],
  "properties": {
    "event_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "scope_server_id": {"type": ["string", "null"]},
    "model_key": {"type": "string"},
    "model_version": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "document_count": {"type": "integer", "minimum": 0},
    "source_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
