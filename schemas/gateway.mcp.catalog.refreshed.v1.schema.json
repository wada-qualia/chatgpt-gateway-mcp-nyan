{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway.mcp.catalog.refreshed.v1",
  "title": "McpCatalogRefreshed",
  "type": "object",
  "required": [
    "event_id",
    "occurred_at",
    "server_id",
    "catalog_generation",
    "tool_count",
    "protocol_version",
    "created_revision_count",
    "missing_tool_count",
    "tools_list_changed_seen"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    },
    "catalog_generation": {
      "type": "integer"
    },
    "tool_count": {
      "type": "integer"
    },
    "protocol_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_revision_count": {
      "type": "integer",
      "minimum": 0
    },
    "missing_tool_count": {
      "type": "integer",
      "minimum": 0
    },
    "tools_list_changed_seen": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
